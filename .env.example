# Copy to .env in the project root:  cp .env.example .env
# Used by docker-compose.yml for every service. Never committed.

PORT=5000
DB_USER=postgres
DB_PASSWORD=my13
# Only used when running the backend outside Docker. docker-compose.yml
# overrides this with `db`, the name of the Postgres service on the compose
# network, so this value never applies to the containerised stack.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fieldsync_db
JWT_SECRET=my_jwt_secret_key
# Gmail App Password, not the account password. Without a valid value here
# every "send credentials" email fails with: Missing credentials for "PLAIN".
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Seeded administrator account. POST /api/admin/bootstrap creates it on a fresh
# database; change these before running anywhere real.
ADMIN_EMAIL=admin@fieldsync.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=System Administrator
ADMIN_EMPLOYEE_ID=ADM001

# Published host ports. Only FRONTEND_PORT needs to be reachable from a phone:
# nginx proxies /api and /uploads to the backend over the internal compose
# network, so the app works over a single port. BACKEND_PORT is for direct API
# access and debugging only.
BACKEND_PORT=5001
FRONTEND_PORT=30001
LEGACY_API_PORT=5002
